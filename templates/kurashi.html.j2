{% extends "base.html.j2" %}
{% block title %}きょうの暮らし｜{{ site_name }}{% endblock %}
{% block description %}日野町のごみ収集日（4地区・品目別）と、この先1週間の天気をまとめています。{% endblock %}
{% block subtitle %}ごみの日と天気{% endblock %}

{% block content %}
<section class="section first" id="kurashi">
    <div class="section-head">
      <h2>ごみの収集日</h2>
      <span class="sub">4地区それぞれの予定</span>
    </div>

    {% if not gomi.verified %}
    <p class="fetch-error">
      <b>収集日は未確認です。</b>
      地区の区分けは公式カレンダーどおりですが、曜日はまだ確かめられていません。
      各地区のPDFで確認して <code>data/gomi.json</code> を直し、<code>verified</code> を
      <code>true</code> にするまで、この注意書きが出ます。
    </p>
    {% endif %}

    <div class="gomi-tabs" role="tablist">
      {% for a in gomi.areas %}
      <button type="button" role="tab" data-area="{{ a.id }}"
              aria-selected="{{ 'true' if loop.first else 'false' }}">{{ a.tab_label }}</button>
      {% endfor %}
    </div>

    {% for a in gomi.areas %}
    <div class="gomi-wrap{% if not gomi.verified %} unverified{% endif %}"
         id="gomi-{{ a.id }}" {% if not loop.first %}hidden{% endif %}>
      <div class="gomi-panel">
      <p class="gomi-area">{{ a.name }}</p>
      {% if a.upcoming %}
      <ul class="gomi-list">
        {% for g in a.upcoming[:8] %}
        <li{% if g.in_days == 0 %} class="today-row"{% endif %}>
          <span class="gomi-when">{{ g.when }}</span>
          <span class="gomi-date">{{ g.md }}（{{ g.wd }}）</span>
          <span class="gomi-kinds">
            {% for k in g.kinds %}<span class="chip {{ k.kind }}">{{ k.label }}</span>{% endfor %}
          </span>
        </li>
        {% endfor %}
      </ul>
      {% endif %}
      <p class="gomi-pdf"><a href="{{ a.pdf }}" rel="noopener">この地区のカレンダーPDF（{{ gomi.fiscal_year }}）</a></p>
      </div>

    </div>
    {% endfor %}

    <aside class="gomi-side">
      <h4>出すときの決まり</h4>
      <ul class="gomi-rules">
        {% for c in gomi.common %}<li>{{ c }}</li>{% endfor %}
      </ul>
    </aside>

    <h3 class="sub-head">持ち込み先</h3>
    <ul class="cards">
      {% for f in gomi.facilities %}
      <li class="card">
        <h4>{{ f.name }}</h4>
        <p>{{ f.hours }}<br>{{ f.address }}　<a href="tel:{{ f.tel }}">{{ f.tel }}</a><br>{{ f.note }}</p>
      </li>
      {% endfor %}
    </ul>
    <p class="more">ごみのことは {{ gomi.contact }} へ。</p>

    {% if weather.ok %}
    <h3 class="sub-head" id="tenki">この先の天気</h3>
    <ul class="forecast">
      {% for d in weather.days %}
      <li>
        <svg class="wx-mini" aria-hidden="true"><use href="#wi-{{ d.icon }}"></use></svg>
        <span class="fc-day">{{ d.label }}<i>{{ d.md }}</i></span>
        <span class="fc-weather">{{ d.main }}{% if d.rest %}<i>{{ d.rest }}</i>{% endif %}</span>
        <span class="fc-temp">
          {% if d.high %}<b>{{ d.high }}℃</b>{% endif %}
          {% if d.low %}<i>{{ d.low }}℃</i>{% endif %}
        </span>
      </li>
      {% endfor %}
    </ul>
    {% if weather.overview %}<p class="more">{{ weather.overview[:180] }}{% if weather.overview|length > 180 %}…{% endif %}（気象庁）</p>{% endif %}
    {% endif %}
  </section>

    <p class="back"><a href="{{ home }}">トップに戻る</a>　<a href="{{ home }}#renrakusaki">困ったときの連絡先</a></p>
{% endblock %}

{% block scripts %}
<script>
(function () {
  // ごみの地区タブ。#gomi-B のように直接開ける
  var tabs = document.querySelectorAll('.gomi-tabs button');
  function showArea(id) {
    tabs.forEach(function (tab) {
      var on = tab.dataset.area === id;
      tab.setAttribute('aria-selected', on);
      var panel = document.getElementById('gomi-' + tab.dataset.area);
      if (panel) panel.hidden = !on;
    });
  }
  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      showArea(tab.dataset.area);
      history.replaceState(null, '', '#gomi-' + tab.dataset.area);
    });
  });
  function syncFromHash() {
    var m = (location.hash.match(/^#gomi-(\w+)$/) || [])[1];
    if (m) showArea(m);
  }
  window.addEventListener('hashchange', syncFromHash);
  syncFromHash();
})();
</script>
{% endblock %}
