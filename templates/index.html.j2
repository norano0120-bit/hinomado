{% extends "base.html.j2" %}
{% block title %}{{ site_name }}｜{{ tagline }}{% endblock %}

{% block content %}

  {# ── 今日の日野：桟敷窓に見立てたパネル ── #}
  <section class="today" aria-label="今日の日野">
    <div class="mado weather-mado">
      <span class="sash" aria-hidden="true"></span>
      <h2>きょうの天気</h2>
      {% if weather.ok %}
      {% set d0 = weather.days[0] %}
      <div class="wx-now">
        <svg class="wx-icon" aria-hidden="true"><use href="#wi-{{ d0.icon }}"></use></svg>
        <div class="wx-text">
          <p class="wx-main">{{ d0.main }}</p>
          {% if d0.rest %}<p class="wx-rest">{{ d0.rest }}</p>{% endif %}
        </div>
        <p class="wx-temp">
          {% if d0.high %}<b>{{ d0.high }}</b>{% endif %}{% if d0.low %}<i>{{ d0.low }}</i>{% endif %}
        </p>
      </div>
      <ul class="wx-next">
        {% for d in weather.days[1:3] %}
        <li>
          <svg class="wx-mini" aria-hidden="true"><use href="#wi-{{ d.icon }}"></use></svg>
          <span class="when">{{ d.label }}</span>
          <span class="w">{{ d.main }}</span>
          {% if d.high %}<span class="t">{{ d.high }}℃</span>{% endif %}
        </li>
        {% endfor %}
      </ul>
      {% else %}
      <p class="note">天気を取得できませんでした。<code>scripts/fetch_weather.py</code> を実行してください。</p>
      {% endif %}
    </div>

    <div class="mado">
      <span class="sash" aria-hidden="true"></span>
      <h2>次のごみの日</h2>
      <ul class="gomi-mini{% if not gomi.verified %} unverified{% endif %}">
        {% for a in gomi.areas %}
        <li>
          <a href="#gomi-{{ a.id }}">
            <span class="ga">{{ a.short }}</span>
            {% if a.next %}
            <span class="gd">{{ a.next.when }} {{ a.next.md }}</span>
            <span class="gk">{% for k in a.next.kinds %}{{ k.label }}{% if not loop.last %}・{% endif %}{% endfor %}</span>
            {% else %}
            <span class="gd">未設定</span>
            {% endif %}
          </a>
        </li>
        {% endfor %}
      </ul>
      {% if not gomi.verified %}<p class="note">曜日は未確認です</p>{% endif %}
    </div>

    <div class="mado">
      <span class="sash" aria-hidden="true"></span>
      <h2>これからの催し</h2>
      {% if upcoming %}
      <ul>
        {% for e in upcoming[:4] %}
        <li><span class="when">{{ e.event_date.month }}/{{ e.event_date.day }}</span><a href="{{ e.url }}">{{ e.title | replace('【' ~ e.event_date.month ~ '月' ~ e.event_date.day ~ '日】', '') }}</a></li>
        {% endfor %}
      </ul>
      {% else %}
      <p class="note">日付のわかる催しは今のところ見つかりませんでした。</p>
      {% endif %}
    </div>
  </section>

  {# ── お知らせ ── #}
  <section class="section" id="news">
    <div class="section-head">
      <h2>お知らせ</h2>
      <span class="sub">町・観光協会・商工会などをまとめています</span>
    </div>

    {% if errors %}
    <p class="fetch-error">
      取得できなかった配信元があります（{% for e in errors %}{{ e.source }}{% if not loop.last %}、{% endif %}{% endfor %}）。
      該当分は前回の内容を表示しています。
    </p>
    {% endif %}

    <div class="filters" role="group" aria-label="お知らせの絞り込み">
      <button type="button" data-filter="all" aria-pressed="true">すべて</button>
      {% for key, label in cat_labels.items() %}
      <button type="button" data-filter="{{ key }}" aria-pressed="false">{{ label }}</button>
      {% endfor %}
      <button type="button" data-filter="kosodate" aria-pressed="false">子育て</button>
      <button type="button" data-filter="senior" aria-pressed="false">高齢者</button>
    </div>

    <ul class="news" id="news-list">
      {% for item in items %}
      <li data-cat="{{ item.category }}" data-tags="{{ item.tags | join(' ') }}">
        <span class="date">{{ item.date_label }}</span>
        <span class="badge {{ 'alert' if item.category == 'alert' }}">{{ item.source_short }}</span>
        <a href="{{ item.url }}" rel="noopener">
          <span class="title">{{ item.title }}{% if item.is_new %}<span class="new">NEW</span>{% endif %}</span>
          {% if item.summary %}<span class="summary">{{ item.summary }}</span>{% endif %}
        </a>
      </li>
      {% endfor %}
    </ul>
    <div class="expander">
      <button type="button" id="news-toggle" aria-expanded="false" aria-controls="news-list"></button>
    </div>
    <p class="more">記事の見出しと日付だけを載せています。本文は各配信元でお読みください。</p>
  </section>

  {# ── 時事ニュース ── #}
  <section class="section" id="press">
    <div class="section-head">
      <h2>時事ニュース</h2>
      <span class="sub">日野町が出てくる報道を拾っています</span>
    </div>
    {% if press_items %}
    <ul class="news press">
      {% for item in press_items %}
      <li>
        <span class="date">{{ item.date_label }}</span>
        <span class="badge press">{{ item.source_short }}</span>
        <a href="{{ item.url }}" rel="noopener nofollow">
          <span class="title">{{ item.title }}</span>
          {% if item.summary %}<span class="summary">{{ item.summary }}</span>{% endif %}
        </a>
      </li>
      {% endfor %}
    </ul>
    <p class="more">
      見出しとリンクのみを表示しています。本文は各紙のページでお読みください。
      東京都日野市・鳥取県日野町の記事が紛れないよう、キーワードで絞っています。
      それでも無関係な記事が混じることがあります。
    </p>
    {% else %}
    <p class="empty-note">今のところ、日野町に触れた報道は見つかっていません。</p>
    {% endif %}
  </section>

  {# ── きょうの暮らし ── #}
  <section class="section" id="kurashi">
    <div class="section-head">
      <h2>きょうの暮らし</h2>
      <span class="sub">ごみの日、天気、困ったときの連絡先</span>
    </div>

    {% if not gomi.verified %}
    <p class="fetch-error">
      <b>収集日は未確認です。</b>
      地区の区分けは公式カレンダーどおりですが、曜日はまだ確かめられていません。
      各地区のPDFで確認して <code>data/gomi.json</code> を直し、<code>verified</code> を
      <code>true</code> にするまで、この注意書きが出ます。
    </p>
    {% endif %}

    <h3 class="sub-head">ごみの収集日</h3>
    <div class="gomi-tabs" role="tablist">
      {% for a in gomi.areas %}
      <button type="button" role="tab" data-area="{{ a.id }}"
              aria-selected="{{ 'true' if loop.first else 'false' }}">{{ a.short }}</button>
      {% endfor %}
    </div>

    {% for a in gomi.areas %}
    <div class="gomi-panel{% if not gomi.verified %} unverified{% endif %}"
         id="gomi-{{ a.id }}" {% if not loop.first %}hidden{% endif %}>
      <p class="gomi-area">{{ a.name }}</p>
      {% if a.upcoming %}
      <ul class="gomi-list">
        {% for g in a.upcoming[:8] %}
        <li{% if g.in_days == 0 %} class="today-row"{% endif %}>
          <span class="gomi-when">{{ g.when }}</span>
          <span class="gomi-date">{{ g.md }}（{{ g.wd }}）</span>
          <span class="gomi-kinds">
            {% for k in g.kinds %}<span class="chip {{ k.kind }}">{{ k.label }}</span>{% endfor %}
          </span>
        </li>
        {% endfor %}
      </ul>
      {% endif %}
      <p class="gomi-pdf"><a href="{{ a.pdf }}" rel="noopener">この地区のカレンダーPDF（{{ gomi.fiscal_year }}）</a></p>
    </div>
    {% endfor %}

    <ul class="gomi-rules">
      {% for c in gomi.common %}<li>{{ c }}</li>{% endfor %}
    </ul>

    <h3 class="sub-head">持ち込み先</h3>
    <ul class="cards">
      {% for f in gomi.facilities %}
      <li class="card">
        <h4>{{ f.name }}</h4>
        <p>{{ f.hours }}<br>{{ f.address }}　<a href="tel:{{ f.tel }}">{{ f.tel }}</a><br>{{ f.note }}</p>
      </li>
      {% endfor %}
    </ul>
    <p class="more">ごみのことは {{ gomi.contact }} へ。</p>

    {% if weather.ok %}
    <h3 class="sub-head">この先の天気</h3>
    <ul class="forecast">
      {% for d in weather.days %}
      <li>
        <svg class="wx-mini" aria-hidden="true"><use href="#wi-{{ d.icon }}"></use></svg>
        <span class="fc-day">{{ d.label }}<i>{{ d.md }}</i></span>
        <span class="fc-weather">{{ d.main }}{% if d.rest %}<i>{{ d.rest }}</i>{% endif %}</span>
        <span class="fc-temp">
          {% if d.high %}<b>{{ d.high }}℃</b>{% endif %}
          {% if d.low %}<i>{{ d.low }}℃</i>{% endif %}
        </span>
      </li>
      {% endfor %}
    </ul>
    {% if weather.overview %}<p class="more">{{ weather.overview[:180] }}{% if weather.overview|length > 180 %}…{% endif %}（気象庁）</p>{% endif %}
    {% endif %}

    <h3 class="sub-head">困ったときの連絡先</h3>
    <p class="lead">{{ kurashi.intro }}</p>
    {% for g in kurashi.groups %}
    <div class="kurashi-group">
      <h4>{{ g.title }}</h4>
      <ul class="kurashi-list">
        {% for i in g["items"] %}
        <li>
          <span class="k-name">{% if i.url %}<a href="{{ i.url }}" rel="noopener">{{ i.name }}</a>{% else %}{{ i.name }}{% endif %}</span>
          <span class="k-detail">{{ i.detail }}{% if i.tel %}　<a href="tel:{{ i.tel }}" class="tel">{{ i.tel }}</a>{% endif %}</span>
        </li>
        {% endfor %}
      </ul>
    </div>
    {% endfor %}
  </section>

  {# ── お出かけ ── #}
  <section class="section" id="odekake">
    <div class="section-head">
      <h2>お出かけ</h2>
      <span class="sub">カフェ・名所・自然・祭り</span>
    </div>

    <div class="season">
      <h3>{{ month }}月に行くなら</h3>
      {% if in_season %}
      <p>{% for s in in_season %}<a href="{{ s.url }}">{{ s.name }}</a>{% if not loop.last %}　/　{% endif %}{% endfor %}</p>
      {% else %}
      <p class="empty">花や紅葉の見ごろはひと休みの時期。町なかのカフェと資料館めぐりがおすすめです。</p>
      {% endif %}
    </div>

    {% for group in spot_groups %}
    {% if group.spots %}
    <div class="spot-group">
      <h3>{{ group.label }}</h3>
      <ul class="spots">
        {% for s in group.spots %}
        <li class="spot">
          {% if s.in_season %}<span class="now">{{ s.season_label }}</span>{% endif %}
          <h4><a href="{{ s.url }}" rel="noopener">{{ s.name }}</a></h4>
          <p>{{ s.blurb }}</p>
          {% if s.tags %}
          <div class="tags">{% for t in s.tags %}<span>{{ t }}</span>{% endfor %}</div>
          {% endif %}
          {% if s.links %}
          <div class="sns">
            {% for l in s.links %}
            <a href="{{ l.url }}" rel="noopener" title="{{ l.label }}" aria-label="{{ s.name }}の{{ l.label }}">
              <svg aria-hidden="true"><use href="#wi-{{ l.icon }}"></use></svg><span>{{ l.label }}</span>
            </a>
            {% endfor %}
          </div>
          {% endif %}
          <p class="via">情報：{{ s.source }}</p>
        </li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}
    {% endfor %}
  </section>

{% endblock %}

{% block scripts %}
<script>
(function () {
  var LIMIT = {{ collapse_at }};
  var buttons = document.querySelectorAll('.filters button');
  var rows = Array.prototype.slice.call(document.querySelectorAll('#news-list li'));
  var toggle = document.getElementById('news-toggle');
  var filter = 'all';
  var expanded = false;

  function matches(row) {
    return filter === 'all'
      || row.dataset.cat === filter
      || row.dataset.tags.split(' ').indexOf(filter) !== -1;
  }

  function render() {
    var shown = 0, hiddenCount = 0;
    rows.forEach(function (row) {
      if (!matches(row)) { row.hidden = true; return; }
      shown++;
      var over = shown > LIMIT;
      row.hidden = over && !expanded;
      if (over) hiddenCount++;
    });
    if (hiddenCount === 0) { toggle.hidden = true; return; }
    toggle.hidden = false;
    toggle.textContent = expanded ? 'とじる' : 'あと' + hiddenCount + '件を見る';
    toggle.setAttribute('aria-expanded', expanded);
  }

  buttons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      filter = btn.dataset.filter;
      expanded = false;
      buttons.forEach(function (b) { b.setAttribute('aria-pressed', b === btn); });
      render();
    });
  });
  toggle.addEventListener('click', function () {
    expanded = !expanded;
    render();
    if (!expanded) document.getElementById('news').scrollIntoView({ block: 'start' });
  });
  render();

  // ごみの地区タブ。#gomi-B のように直接開ける
  var tabs = document.querySelectorAll('.gomi-tabs button');
  function showArea(id) {
    tabs.forEach(function (tab) {
      var on = tab.dataset.area === id;
      tab.setAttribute('aria-selected', on);
      var panel = document.getElementById('gomi-' + tab.dataset.area);
      if (panel) panel.hidden = !on;
    });
  }
  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      showArea(tab.dataset.area);
      history.replaceState(null, '', '#gomi-' + tab.dataset.area);
    });
  });
  // 上の窓から「#gomi-B」で飛んできたときもタブを合わせる
  function syncFromHash() {
    var m = (location.hash.match(/^#gomi-(\w+)$/) || [])[1];
    if (m) showArea(m);
  }
  window.addEventListener('hashchange', syncFromHash);
  syncFromHash();
})();
</script>
{% endblock %}
