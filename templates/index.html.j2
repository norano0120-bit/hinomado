{% extends "base.html.j2" %}
{% block title %}{{ site_name }}｜{{ tagline }}{% endblock %}

{% block content %}

  {% if festivals_now %}
  {# ── 開催月に入った祭り。終わると自動で消える ── #}
  <section class="matsuri" aria-label="開催が近い祭り">
    {% for f in festivals_now %}
    <article class="matsuri-card">
      <p class="m-state">{{ f.state }}</p>
      <h2><a href="{{ f.url }}" rel="noopener">{{ f.name }}</a></h2>
      <p class="m-when">{{ f.range_label }}{% if f.approximate %}<span class="m-approx">年により前後します</span>{% endif %}</p>
      <p class="m-blurb">{{ f.blurb }}</p>
    </article>
    {% endfor %}
  </section>
  {% endif %}

  {# ── 今日の日野：桟敷窓に見立てたパネル ── #}
  <section class="today" aria-label="今日の日野">
    <div class="mado weather-mado">
      <span class="sash" aria-hidden="true"></span>
      <h2>きょうの天気</h2>
      {% if weather.ok %}
      {% set d0 = weather.days[0] %}
      <div class="wx-now">
        <svg class="wx-icon" aria-hidden="true"><use href="#wi-{{ d0.icon }}"></use></svg>
        <div class="wx-text">
          <p class="wx-main">{{ d0.main }}</p>
          {% if d0.rest %}<p class="wx-rest">{{ d0.rest }}</p>{% endif %}
        </div>
        <p class="wx-temp">
          {% if d0.high %}<b>{{ d0.high }}</b>{% endif %}{% if d0.low %}<i>{{ d0.low }}</i>{% endif %}
        </p>
      </div>
      <ul class="wx-next">
        {% for d in weather.days[1:4] %}
        <li>
          <svg class="wx-mini" aria-hidden="true"><use href="#wi-{{ d.icon }}"></use></svg>
          <span class="when">{{ d.label }}</span>
          <span class="w">{{ d.main }}</span>
          {% if d.high %}<span class="t">{{ d.high }}℃</span>{% endif %}
        </li>
        {% endfor %}
      </ul>
      <p class="mado-more"><a href="kurashi.html#tenki">1週間の天気を見る</a></p>
      {% else %}
      <p class="note">天気を取得できませんでした。<code>scripts/fetch_weather.py</code> を実行してください。</p>
      {% endif %}
    </div>

    <div class="mado">
      <span class="sash" aria-hidden="true"></span>
      <h2>次のごみの日</h2>
      <ul class="gomi-mini{% if not gomi.verified %} unverified{% endif %}">
        {% for a in gomi.areas %}
        <li>
          <a href="kurashi.html#gomi-{{ a.id }}">
            <span class="ga">{{ a.name }}</span>
            {% if a.next %}
            <span class="gd">{{ a.next.when }} {{ a.next.md }}
              <b>{% for k in a.next.kinds %}{{ k.label }}{% if not loop.last %}・{% endif %}{% endfor %}</b>
            </span>
            {% else %}
            <span class="gd">未設定</span>
            {% endif %}
          </a>
        </li>
        {% endfor %}
      </ul>
      {% if not gomi.verified %}<p class="note">曜日は未確認です</p>{% endif %}
    </div>

    <div class="mado">
      <span class="sash" aria-hidden="true"></span>
      <h2>これからの催し</h2>
      {% if upcoming %}
      <ul>
        {% for e in upcoming[:4] %}
        <li><span class="when">{{ e.event_date.month }}/{{ e.event_date.day }}</span><a href="{{ e.url }}">{{ e.title | replace('【' ~ e.event_date.month ~ '月' ~ e.event_date.day ~ '日】', '') }}</a></li>
        {% endfor %}
      </ul>
      {% else %}
      <p class="note">日付のわかる催しは今のところ見つかりませんでした。</p>
      {% endif %}
    </div>
  </section>

  {% if posts %}
  {# ── 書いたもの（写真つきで上に出す） ── #}
  <section class="section" id="kiji-top">
    <div class="section-head">
      <h2>書いたもの</h2>
      <span class="sub">実際に行って書いた記事</span>
    </div>
    <ul class="top-posts">
      {% for p in posts[:3] %}
      <li>
        <a class="tp-link" href="{{ p.url }}">
          {% if p.thumb %}
          <img src="{{ p.thumb }}" alt="" loading="lazy">
          {% else %}
          <span class="tp-noimg" aria-hidden="true"></span>
          {% endif %}
          <span class="tp-date">{{ p.date_label }}</span>
          <span class="tp-title">{{ p.title }}</span>
        </a>
        {% if p.summary %}<p class="tp-sum">{{ p.summary }}</p>{% endif %}
      </li>
      {% endfor %}
    </ul>
    <p class="more"><a href="kiji.html">記事の一覧へ</a></p>
  </section>
  {% endif %}

  {# ── お知らせ ── #}
  <section class="section" id="news">
    <div class="section-head">
      <h2>お知らせ</h2>
      <span class="sub">町・観光協会・商工会などをまとめています</span>
    </div>

    {% if errors %}
    <p class="fetch-error">
      取得できなかった配信元があります（{% for e in errors %}{{ e.source }}{% if not loop.last %}、{% endif %}{% endfor %}）。
      該当分は前回の内容を表示しています。
    </p>
    {% endif %}

    <div class="filters" role="group" aria-label="お知らせの絞り込み">
      <button type="button" data-filter="all" aria-pressed="true">すべて</button>
      {% for key, label in cat_labels.items() %}
      <button type="button" data-filter="{{ key }}" aria-pressed="false">{{ label }}</button>
      {% endfor %}
      <button type="button" data-filter="kosodate" aria-pressed="false">子育て</button>
      <button type="button" data-filter="senior" aria-pressed="false">高齢者</button>
    </div>

    <ul class="news" id="news-list">
      {% for item in items[:60] %}
      <li data-cat="{{ item.category }}" data-tags="{{ item.tags | join(' ') }}">
        <span class="date">{{ item.date_label }}</span>
        <span class="badge {{ 'alert' if item.category == 'alert' }}">{{ item.source_short }}</span>
        <a href="{{ item.url }}" rel="noopener">
          <span class="title">{{ item.title }}{% if item.is_new %}<span class="new">NEW</span>{% endif %}</span>
          {% if item.summary %}<span class="summary">{{ item.summary }}</span>{% endif %}
        </a>
      </li>
      {% endfor %}
    </ul>
    <div class="expander">
      <button type="button" id="news-toggle" aria-expanded="false" aria-controls="news-list"></button>
    </div>
    <p class="more">記事の見出しと日付だけを載せています。本文は各配信元でお読みください。</p>
  </section>

  {# ── 時事ニュース ── #}
  <section class="section" id="press">
    <div class="section-head">
      <h2>時事ニュース</h2>
      <span class="sub">日野町が出てくる報道を拾っています</span>
    </div>
    {% if press_items %}
    <ul class="news press" id="press-list">
      {% for item in press_items %}
      <li>
        <span class="date">{{ item.date_label }}</span>
        <span class="badge press">{{ item.source_short }}</span>
        <a href="{{ item.url }}" rel="noopener nofollow">
          <span class="title">{{ item.title }}</span>
          {% if item.summary %}<span class="summary">{{ item.summary }}</span>{% endif %}
        </a>
      </li>
      {% endfor %}
    </ul>
    <div class="expander">
      <button type="button" id="press-toggle" aria-expanded="false" aria-controls="press-list"></button>
    </div>
    <p class="more">
      見出しとリンクのみを表示しています。本文は各紙のページでお読みください。
      東京都日野市・鳥取県日野町の記事が紛れないよう、キーワードで絞っています。
      それでも無関係な記事が混じることがあります。
    </p>
    {% else %}
    <p class="empty-note">今のところ、日野町に触れた報道は見つかっていません。</p>
    {% endif %}
  </section>

  {# ── お出かけ ── #}
  <section class="section" id="odekake">
    <div class="section-head">
      <h2>お出かけ</h2>
      <span class="sub">カフェ・名所・自然・祭り</span>
    </div>

    <div class="season">
      <h3>{{ month }}月に行くなら</h3>
      {% if in_season %}
      <p>{% for s in in_season %}<a href="{{ s.url }}">{{ s.name }}</a>{% if not loop.last %}　/　{% endif %}{% endfor %}</p>
      {% else %}
      <p class="empty">花や紅葉の見ごろはひと休みの時期。町なかのカフェと資料館めぐりがおすすめです。</p>
      {% endif %}
    </div>

    {% for group in spot_groups %}
    {% if group.spots %}
    <div class="spot-group">
      <h3>{{ group.label }}</h3>
      <ul class="spots">
        {% for s in group.spots %}
        <li class="spot{% if s.closed %} is-closed{% endif %}">
          {% if s.photo %}
          <span class="spot-photo">
            <img src="{{ s.photo }}" alt="{{ s.name }}" loading="lazy">
            {% if s.photo_note %}<i>{{ s.photo_note }}</i>{% endif %}
          </span>
          {% else %}
          <span class="spot-band cat-{{ s.cat }}" aria-hidden="true">
            <svg><use href="#ic-{{ s.cat }}"></use></svg>
          </span>
          {% endif %}
          {% if s.closed %}<span class="closed-mark">閉園{% if s.closed_note %}・{{ s.closed_note }}{% endif %}</span>
          {% elif s.in_season %}<span class="now">{{ s.season_label }}</span>{% endif %}
          <h4><a href="{{ s.url }}" rel="noopener">{{ s.name }}</a></h4>
          {% if s.when_label %}<p class="spot-when">{{ s.when_label }}</p>{% endif %}
          <p>{{ s.blurb }}</p>
          {% if s.tags %}
          <div class="tags">{% for t in s.tags %}<span>{{ t }}</span>{% endfor %}</div>
          {% endif %}
          {% if s.links %}
          <div class="sns">
            {% for l in s.links %}
            <a href="{{ l.url }}" rel="noopener" title="{{ l.label }}" aria-label="{{ s.name }}の{{ l.label }}">
              <svg aria-hidden="true"><use href="#wi-{{ l.icon }}"></use></svg><span>{{ l.label }}</span>
            </a>
            {% endfor %}
          </div>
          {% endif %}
          <p class="via">情報：{{ s.source }}</p>
        </li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}
    {% endfor %}
  </section>

  {# ── 困ったときの連絡先（ページ末尾） ── #}
  <section class="section" id="renrakusaki">
    <div class="section-head">
      <h2>困ったときの連絡先</h2>
      <span class="sub">電話番号はそのままかけられます</span>
    </div>
    <p class="lead">{{ kurashi.intro }}</p>
    <div class="kurashi-cols">
      {% for g in kurashi.groups %}
      <div class="kurashi-group">
        <h4>{{ g.title }}</h4>
        <ul class="kurashi-list">
          {% for i in g["items"] %}
          <li>
            <span class="k-name">{% if i.url %}<a href="{{ i.url }}" rel="noopener">{{ i.name }}</a>{% else %}{{ i.name }}{% endif %}</span>
            <span class="k-detail">{{ i.detail }}{% if i.tel %}　<a href="tel:{{ i.tel }}" class="tel">{{ i.tel }}</a>{% endif %}</span>
          </li>
          {% endfor %}
        </ul>
      </div>
      {% endfor %}
    </div>
  </section>

{% endblock %}

{% block scripts %}
<script>
(function () {
  var LIMIT = {{ collapse_at }};

  // 一覧を LIMIT 件で折りたたむ。絞り込みがあれば連動させる
  function makeExpander(listId, toggleId, buttons) {
    var rows = Array.prototype.slice.call(
      document.querySelectorAll('#' + listId + ' > li'));
    var toggle = document.getElementById(toggleId);
    if (!toggle || !rows.length) return null;
    var filter = 'all';
    var expanded = false;

    function matches(row) {
      if (!buttons) return true;
      return filter === 'all'
        || row.dataset.cat === filter
        || (row.dataset.tags || '').split(' ').indexOf(filter) !== -1;
    }

    function render() {
      var shown = 0, hidden = 0;
      rows.forEach(function (row) {
        if (!matches(row)) { row.hidden = true; return; }
        shown++;
        var over = shown > LIMIT;
        row.hidden = over && !expanded;
        if (over) hidden++;
      });
      if (hidden === 0) { toggle.hidden = true; return; }
      toggle.hidden = false;
      toggle.textContent = expanded ? 'とじる' : 'あと' + hidden + '件を見る';
      toggle.setAttribute('aria-expanded', expanded);
    }

    toggle.addEventListener('click', function () {
      expanded = !expanded;
      render();
      if (!expanded) {
        document.getElementById(listId).closest('.section')
          .scrollIntoView({ block: 'start' });
      }
    });

    if (buttons) {
      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          filter = btn.dataset.filter;
          expanded = false;
          buttons.forEach(function (b) { b.setAttribute('aria-pressed', b === btn); });
          render();
        });
      });
    }
    render();
    return render;
  }

  makeExpander('news-list', 'news-toggle',
    Array.prototype.slice.call(document.querySelectorAll('.filters button')));
  makeExpander('press-list', 'press-toggle', null);
})();
</script>
{% endblock %}
